#version 460
// Edge-avoiding a-trous wavelet filter, the spatial part of SVGF.
//
// Mode 0 estimates the variance: accumulation -> dst (rgb radiance, a variance of the mean).
// Mode 1 runs one iteration: src -> dst with a 5x5 B3-spline kernel spaced by stepSize.
//
// Edges are detected through normals, path distance, albedo and luminance. The luminance tolerance scales with the
// estimated noise, so the blur fades out as the accumulation converges and the result stays unbiased.

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0, rgba32f) uniform readonly image2D accumImage;
layout(set = 0, binding = 1, rgba32f) uniform readonly image2D gNormalDepth;
layout(set = 0, binding = 2, rgba16f) uniform readonly image2D gAlbedo;
layout(set = 0, binding = 3, rgba16f) uniform readonly image2D srcImage;
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D dstImage;
layout(set = 0, binding = 5, rgba32f) uniform readonly image2D metaImage;   // x: samples in this pixel's history

layout(push_constant) uniform Params {
    int   mode;
    int   stepSize;
    uint  historyLimit;   // max samples per pixel, 0 = unlimited
    float sigmaLuminance; // ~4
    float sigmaNormal;    // exponent, ~128
    float sigmaDepth;     // relative, ~0.02
    float sigmaAlbedo;    // ~0.1
    int   demodulate;     // 1: filter radiance / albedo; composite multiplies the albedo back
    uint  frame;          // rotates the disocclusion fix's sampling pattern
    float fixStrength;    // weight of the disocclusion fix's estimate per sample of history advantage, 0 = off
} pc;

float luminance(vec3 c) { return dot(c, vec3(0.2126, 0.7152, 0.0722)); }

// The filter images are half floats, whose largest value is 65504. A bright highlight on a dark surface, divided by
// the albedo for filtering, can exceed that; the resulting inf and NaN would spread over the whole kernel and show
// as a black square. Values are kept finite before they are stored.
const float HALF_MAX = 60000.0;
vec4 storable(vec4 v) { return clamp(mix(v, vec4(0.0), isnan(v)), -HALF_MAX, HALF_MAX); }


// A pixel below this share of its darkest neighbor counts as a dark outlier (see the firefly suppression).
const float DARK_OUTLIER_RATIO = 0.5;

bool inside(ivec2 p, ivec2 size) { return all(greaterThanEqual(p, ivec2(0))) && all(lessThan(p, size)); }
// Albedo used for demodulation; must match composite.comp. Sky and black surfaces are not demodulated.
vec3 demodAlbedo(vec3 a) { return pc.demodulate == 0 || luminance(a) < 1e-3 ? vec3(1.0) : max(a, vec3(0.02)); }

// Disocclusion fix
//
// A pixel that just came into view - behind an edge the camera moves past - starts with a few catch-up samples.
// Its illumination is noisy and often far too dark, and the a-trous filter alone cannot hide that: its neighbors
// in the newly revealed band are just as new, and the luminance stop keeps the converged surface next to the band
// out. This pass treats the converged neighborhood as a prior. It gathers the illumination of neighbors that lie
// on the same surface (normal, depth) and have more samples than the pixel, and blends it in with the weight of
// their extra samples, so a new pixel looks like its surroundings right away and its own samples take over as they
// accumulate. Because the image is demodulated, texture detail is not blurred; only the lighting is borrowed.
// Pixels whose history was merely shortened (moving camera, glass, mirrors) have neighbors with equally short
// histories and are left alone.
const int   FIX_TAPS = 16;
const float FIX_FRAMES = 32.0;

const float FIX_RADIUS = 14.0;

const float FIX_MIN_RADIUS = 3.0;
// Light differences above this many standard deviations of the pixel's own estimate are real (a shadow edge)
// rather than noise, and such neighbors are left out.
const float FIX_SIGMAS = 3.0;

// The disocclusion fix for one pixel. Gathers FIX_TAPS taps on a Vogel disk, rotated per pixel and frame (the
// temporal stage averages the pattern away). The luminance test only starts once the pixel has more than its
// catch-up samples, since a brand-new pixel's own estimate is too noisy to judge its neighbors by; its sigma comes
// from mode 0's variance, where dark outliers already carry their neighbors' spread. The estimate's weight in samples
// is the neighbors' mean extra samples, faded out towards FIX_FRAMES and reduced when few taps match; its variance is
// taken over too, as it is far less noisy than the pixel.
vec4 disocclusionFix(ivec2 p, ivec2 size, vec3 nC, float zC) {
    vec4 center = imageLoad(srcImage, p);
    float count = imageLoad(metaImage, p).x;
    if (pc.fixStrength <= 0.0 || zC <= 0.0 || count >= FIX_FRAMES) return center;
    float lC = luminance(center.rgb);
    float sigma = sqrt(max(center.a, 0.0)) * FIX_SIGMAS + 0.05 * lC + 1e-3;
    float radius = mix(FIX_RADIUS, FIX_MIN_RADIUS, count / FIX_FRAMES);
    float angle = fract(52.9829189 * fract(dot(vec2(p), vec2(0.06711056, 0.00583715))) + float(pc.frame % 64u) * 0.618034) * 6.2831853;
    vec3 sum = vec3(0.0);
    float wSum = 0.0, advantage = 0.0, geoSum = 0.0, varSum = 0.0;
    for (int i = 0; i < FIX_TAPS; ++i) {
        float r = radius * sqrt((float(i) + 0.5) / float(FIX_TAPS));
        float a = float(i) * 2.3999632 + angle;
        ivec2 q = p + ivec2(round(vec2(cos(a), sin(a)) * r));
        if (!inside(q, size) || q == p) continue;
        vec4 ndQ = imageLoad(gNormalDepth, q);
        if (ndQ.w <= 0.0) continue;
        float cq = imageLoad(metaImage, q).x;
        float extra = cq - count;
        if (extra <= 0.0) continue;
        float g = pow(max(dot(nC, ndQ.xyz), 0.0), 32.0) * exp(-abs(zC - ndQ.w) / (0.01 * zC * max(r, 1.0) + 1e-3));
        if (g < 1e-3) continue;
        vec4 s = imageLoad(srcImage, q);
        float wl = exp(-abs(luminance(s.rgb) - lC) / sigma);
        wl = mix(1.0, wl, clamp((count - 8.0) / 16.0, 0.0, 1.0));
        float w = g * wl * extra;
        sum += s.rgb * w;
        varSum += s.a * w;
        wSum += w;
        advantage += g * wl * min(extra, FIX_FRAMES);
        geoSum += g;
    }
    if (wSum <= 0.0) return center;
    float k = pc.fixStrength * advantage / max(geoSum, 1e-6) * (1.0 - smoothstep(0.5 * FIX_FRAMES, FIX_FRAMES, count));
    k *= clamp(geoSum / 3.0, 0.0, 1.0);
    float own = max(count, 1.0);
    float t = k / (own + k);
    vec3 color = mix(center.rgb, sum / wSum, t);
    float variance = mix(center.a, varSum / wSum, t);
    return storable(vec4(color, variance));
}

// One pixel of the pass selected by pc.mode.
//
// Mode 0, variance estimation: the illumination (radiance / albedo) and the variance of its mean, from the history's
// second moment (Var[X] = E[X^2] - E[X]^2, over N) once there are 4 samples, before that from similar neighbors in
// a 7x7 window (doubled, since spatial estimates under-represent the per-pixel noise). Then firefly suppression on
// the filter input only, also on converged pixels, so the accumulation stays unbiased: a pixel far brighter than all
// of its surface neighbors (any surface pixel counts, since at model edges and on normal-mapped surfaces few share
// the normal) is pulled down to them. A pixel far darker than all of them would claim a variance of 0, keep every
// neighbor out and grow into a black blotch; it gets the spread to its neighbors as variance instead.
//
// Mode 2, the disocclusion fix, see above.
//
// Mode 1, one a-trous iteration: the 5x5 kernel, its luminance stop scaled by the 3x3-blurred variance, which makes
// edge stopping more robust. Sky pixels pass unchanged.
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(accumImage);
    if (!inside(p, size)) return;

    vec4 ndC = imageLoad(gNormalDepth, p);
    vec3 nC = ndC.xyz;
    float zC = ndC.w;
    vec3 aC = imageLoad(gAlbedo, p).rgb;

    if (pc.mode == 0) {
        vec4 acc = imageLoad(accumImage, p);
        vec3 alb = demodAlbedo(aC);
        float albL = luminance(alb);
        acc.rgb /= alb;
        acc.a /= albL * albL;
        float l = luminance(acc.rgb);
        float count = max(imageLoad(metaImage, p).x, 1.0);
        float variance;
        if (count >= 4.0) {
            variance = max(acc.a - l * l, 0.0) / count;
        } else {
            float s1 = 0.0, s2 = 0.0, wSum = 0.0;
            for (int dy = -3; dy <= 3; ++dy) {
                for (int dx = -3; dx <= 3; ++dx) {
                    ivec2 q = p + ivec2(dx, dy);
                    if (!inside(q, size)) continue;
                    vec4 ndQ = imageLoad(gNormalDepth, q);
                    float w = (zC > 0.0 && ndQ.w > 0.0)
                        ? pow(max(dot(nC, ndQ.xyz), 0.0), 16.0) * exp(-abs(zC - ndQ.w) / (0.05 * zC + 1e-3))
                        : float(zC <= 0.0 && ndQ.w <= 0.0);
                    float lq = luminance(imageLoad(accumImage, q).rgb / demodAlbedo(imageLoad(gAlbedo, q).rgb));
                    s1 += lq * w; s2 += lq * lq * w; wSum += w;
                }
            }
            float mean = s1 / max(wSum, 1e-6);
            variance = max(s2 / max(wSum, 1e-6) - mean * mean, 0.0) / count;
            variance *= 2.0;
        }
        vec3 color = acc.rgb;
        if (zC > 0.0) {
            float maxL = 0.0, minL = 1e30;
            vec3 meanC = vec3(0.0);
            float cnt = 0.0;
            for (int dy = -1; dy <= 1; ++dy) {
                for (int dx = -1; dx <= 1; ++dx) {
                    if (dx == 0 && dy == 0) continue;
                    ivec2 q = p + ivec2(dx, dy);
                    if (!inside(q, size)) continue;
                    vec4 ndQ = imageLoad(gNormalDepth, q);
                    if (ndQ.w <= 0.0) continue;
                    vec3 cq = imageLoad(accumImage, q).rgb / demodAlbedo(imageLoad(gAlbedo, q).rgb);
                    maxL = max(maxL, luminance(cq));
                    minL = min(minL, luminance(cq));
                    meanC += cq;
                    cnt += 1.0;
                }
            }
            float limit = maxL * (count >= 32.0 ? 2.0 : 1.5) + 0.02;
            if (cnt >= 4.0 && l > limit) {
                color = mix(meanC / cnt, color * (limit / l), 0.5);
                variance = max(variance, (l - limit) * (l - limit) / count);
            } else if (cnt >= 4.0 && l < DARK_OUTLIER_RATIO * minL) {
                variance = max(variance, (minL - l) * (minL - l));
            }
        }
        imageStore(dstImage, p, storable(vec4(color, variance)));
        return;
    }

    if (pc.mode == 2) {
        imageStore(dstImage, p, disocclusionFix(p, size, nC, zC));
        return;
    }

    vec4 center = imageLoad(srcImage, p);
    if (zC <= 0.0) {
        imageStore(dstImage, p, center);
        return;
    }

    float varBlur = 0.0, varW = 0.0;
    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            ivec2 q = clamp(p + ivec2(dx, dy), ivec2(0), size - 1);
            float k = (dx == 0 ? 0.5 : 0.25) * (dy == 0 ? 0.5 : 0.25);
            varBlur += imageLoad(srcImage, q).a * k;
            varW += k;
        }
    }
    float sigmaL = pc.sigmaLuminance * sqrt(max(varBlur / varW, 0.0)) + 1e-5;
    float lC = luminance(center.rgb);

    const float kernel[3] = float[3](3.0 / 8.0, 1.0 / 4.0, 1.0 / 16.0);
    vec3 colorSum = center.rgb * (kernel[0] * kernel[0]);
    float varianceSum = center.a * (kernel[0] * kernel[0]) * (kernel[0] * kernel[0]);
    float weightSum = kernel[0] * kernel[0];

    for (int dy = -2; dy <= 2; ++dy) {
        for (int dx = -2; dx <= 2; ++dx) {
            if (dx == 0 && dy == 0) continue;
            ivec2 q = p + ivec2(dx, dy) * pc.stepSize;
            if (!inside(q, size)) continue;
            vec4 ndQ = imageLoad(gNormalDepth, q);
            if (ndQ.w <= 0.0) continue;
            vec4 s = imageLoad(srcImage, q);
            vec3 aQ = imageLoad(gAlbedo, q).rgb;

            float dist = length(vec2(dx, dy)) * float(pc.stepSize);
            float wN = pow(max(dot(nC, ndQ.xyz), 0.0), pc.sigmaNormal);
            float wZ = exp(-abs(zC - ndQ.w) / (pc.sigmaDepth * zC * dist + 1e-4));
            vec3 da = aC - aQ;
            float wA = exp(-dot(da, da) / (pc.sigmaAlbedo * pc.sigmaAlbedo));
            float wL = exp(-abs(lC - luminance(s.rgb)) / sigmaL);
            float h = kernel[abs(dx)] * kernel[abs(dy)];
            float w = h * wN * wZ * wA * wL;

            colorSum += s.rgb * w;
            varianceSum += s.a * w * w;
            weightSum += w;
        }
    }
    imageStore(dstImage, p, storable(vec4(colorSum / weightSum, varianceSum / (weightSum * weightSum))));
}
