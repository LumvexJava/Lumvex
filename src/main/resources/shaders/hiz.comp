#version 460
// One level of the Hi-Z pyramid of the raster pre-pass (see RasterPrepass.java and raster_cull.comp): each texel is
// the farthest (smallest, the depth is reversed) depth of the 2x2 texels below it. Where the level below has an odd
// size, the last texels also take in the third row or column, so the pyramid never claims more occlusion than the
// depth buffer has.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D source;   // the depth buffer, or the level below
layout(set = 0, binding = 1, r32f) uniform writeonly image2D target;

// Writes one texel: the minimum over the two (or, at an odd edge, three) rows and columns of the level below it.
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(target);
    if (any(greaterThanEqual(p, size))) return;
    ivec2 src = textureSize(source, 0);
    ivec2 b = p * 2;
    ivec2 last = min(b + ivec2(1), src - 1);
    if (p.x == size.x - 1) last.x = src.x - 1;
    if (p.y == size.y - 1) last.y = src.y - 1;
    float d = 1.0;
    for (int y = b.y; y <= last.y; ++y)
        for (int x = b.x; x <= last.x; ++x) d = min(d, texelFetch(source, ivec2(x, y), 0).r);
    imageStore(target, p, vec4(d));
}
