#version 460
#extension GL_EXT_ray_query : require
// Lens flare visibility, one workgroup per source. 64 ray queries towards random points on the source's disk
// measure how much of it is visible, so flares fade smoothly as a source slides behind an object. Glass and light
// proxies do not occlude. composite.comp draws the flares.

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;

struct Flare {
    vec4 source;   // xyz: position, or direction for the sun; w: radius, negative angular radius for the sun
    vec4 color;    // intensity at the lens
    vec4 state;    // written here: xy pixel position, z smoothed visibility, w 1 if in front of the camera
};
layout(std430, set = 0, binding = 1) buffer FlareBuffer {
    mat4 viewProj;
    vec4 camPos;   // w: number of flares
    vec4 screen;   // xy: resolution, z: frame index, w: temporal blend (1 = no smoothing)
    Flare flares[];
} fb;

shared uint visibleCount;

// Integer hash to a float in [0, 1).
float hash(uint x) {
    x ^= x >> 16; x *= 0x7feb352du; x ^= x >> 15; x *= 0x846ca68bu; x ^= x >> 16;
    return float(x) * (1.0 / 4294967296.0);
}

void main() {
    uint id = gl_WorkGroupID.x, t = gl_LocalInvocationIndex;
    if (t == 0u) visibleCount = 0u;
    barrier();

    vec4 src = fb.flares[id].source;
    vec3 cam = fb.camPos.xyz;
    bool sun = src.w < 0.0;
    vec3 toL = sun ? normalize(src.xyz) : src.xyz - cam;
    float dist = sun ? 1e4 : length(toL);
    vec3 dir0 = toL / (sun ? 1.0 : max(dist, 1e-4));
    float ang = sun ? -src.w : asin(min(src.w / max(dist, 1e-4), 1.0));

    // Stratified point on the source's disk; the outer 15% are skipped since the limb barely contributes.
    uint seed = t * 9781u + uint(fb.screen.z) * 6271u + id * 7919u;
    float r = sqrt((float(t) + hash(seed)) / 64.0) * ang * 0.85, phi = 6.2831853 * hash(seed * 3u + 1u);
    vec3 tA = normalize(abs(dir0.y) < 0.99 ? cross(dir0, vec3(0, 1, 0)) : cross(dir0, vec3(1, 0, 0)));
    vec3 tB = cross(dir0, tA);
    vec3 d = normalize(dir0 + (cos(phi) * tA + sin(phi) * tB) * tan(r));
    float tMax = sun ? 1e4 : max(dist - src.w, 1e-3);

    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, tlas, gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT, 0x01, cam, 1e-3, d, tMax);
    while (rayQueryProceedEXT(rq)) {}
    if (rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionNoneEXT) atomicAdd(visibleCount, 1u);
    barrier();

    if (t == 0u) {
        vec3 center = sun ? cam + dir0 * 500.0 : src.xyz;
        vec4 clip = fb.viewProj * vec4(center, 1.0);
        bool front = clip.w > 1e-4;
        vec2 ndc = front ? clip.xy / clip.w : vec2(0.0);
        vec2 px = vec2((ndc.x * 0.5 + 0.5) * fb.screen.x, (0.5 - 0.5 * ndc.y) * fb.screen.y);
        float vis = front ? float(visibleCount) / 64.0 : 0.0;
        float prev = fb.flares[id].state.z;
        fb.flares[id].state = vec4(px, mix(prev, vis, fb.screen.w), front ? 1.0 : 0.0);
    }
}
